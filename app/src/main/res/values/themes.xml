<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light, like the Studio UI, with Paper behind the window so there is no dark flash at launch. -->
    <style name="Base.Theme.Poseit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/studio_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Poseit" parent="Base.Theme.Poseit" />
</resources>
