{
  "name": "poseit-promo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Poseit promo film (vertical 1080x1920, 30 fps), built in Remotion from the app's own pose data",
  "license": "MIT",
  "scripts": {
    "prestudio": "npm run -s audio",
    "studio": "remotion studio src/index.ts",
    "poses": "cd .. && ./gradlew --console=plain -q :pose-core:test --tests 'com.poseit.app.tools.PromoPoseExport'",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/check-shapes.ts && npm run -s check-live",
    "still": "remotion still src/index.ts",
    "prerender": "npm run -s audio",
    "render": "remotion render src/index.ts Promo out/poseit-promo.mp4 --codec h264 --crf 16 --overwrite",
    "predraft": "npm run -s audio",
    "draft": "remotion render src/index.ts Promo out/draft.mp4 --codec h264 --crf 22 --scale 0.5",
    "assets": "bash scripts/assets.sh",
    "events": "esbuild scripts/export-events.ts --bundle --platform=node --format=esm --outfile=out/export-events.mjs --log-level=warning && node out/export-events.mjs",
    "audio": "npm run -s events && node scripts/gen-audio.mjs",
    "check-live": "esbuild scripts/check-live.ts --bundle --platform=node --format=esm --outfile=out/check-live.mjs --log-level=warning && node out/check-live.mjs",
    "footage": "node scripts/fetch-footage.mjs",
    "landmarks": "node scripts/landmarks.mjs",
    "footage-match": "node scripts/footage-match.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
