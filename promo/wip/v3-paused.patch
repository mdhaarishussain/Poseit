+/**
+ * Captions.tsx: THE caption layer of the v3 film (STORYBOARD v3 sections 8 and 11). One component, used once, frontmost
+ * over the whole film (Promo.tsx); every sentence comes from beats.ts CAPTIONS and every size from CAPTION_SYSTEM via
+ * captions/layout.ts.
+ *
+ *   <Captions frame={global frame} />
+ *
+ * Band captions (C1-C9) are the film talking to the viewer: one sentence at a time, Archivo SemiBold 0.051 H, Ink on a
+ * Sheet cue card that hugs the text (no dot, no border, no shadow), centred, in the top band (card top 0.135 H) or the
+ * bottom band (card bottom 0.865 H). The card rises 0.012 H and resolves in 8 f; its words rise whole, 3 f apart; the
+ * whole card leaves upward over its last 6 f. A line flagged `wordmarkLine` (C2's "Poseit") is set in Archivo
+ * Expanded SemiBold, the wordmark's face, at the same size.
+ *
+ * End lines (C10-C12) are Ink on Paper with no card, stacked under the wordmark at studio/lockup.ts rows; their words
+ * resolve in place (blur 8 -> 0 px) 3 f apart, and they take the end's living hold (endCreep about LOCKUP_ORIGIN) so
+ * they move as one with the icon and the wordmark.
+ *
+ * Words keep their space before they appear (no re-centring jumps). Real spaces between words, so the measure is the
+ * font's own (the widest line, "No account, no ads.", is about 0.83 W).
+ */
+import React from "react";
+import { AbsoluteFill } from "remotion";
+import type { Caption } from "../beats";
+import { theme } from "../theme";
+import { CAP, captionMotion, captionWords, captionsAt, cardTop, wordMotion } from "./layout";
+import { LOCKUP_ORIGIN, endCreep } from "../scenes/studio/lockup";
+
+const { W } = theme.size;
+
+const CaptionView: React.FC<{ caption: Caption; frame: number }> = ({ caption: c, frame }) => {
+  const m = captionMotion(c, frame);
+  if (!m.shown) return null;
+  const words = captionWords(c);
+  const isEnd = c.band === "end";
+  const lines = c.lines.map((_, li) => words.filter((w) => w.line === li));
+  return (
+    <div
+      style={{
+        position: "absolute",
+        left: 0,
+        width: W,
+        top: cardTop(c),
+        display: "flex",
+        justifyContent: "center",
+        transform: `translateY(${m.rise}px)`,
+        opacity: m.opacity,
+      }}
+    >
+      <div
+        style={{
+          background: isEnd ? undefined : CAP.fill,
+          borderRadius: isEnd ? undefined : CAP.radius,
+          padding: isEnd ? 0 : `${CAP.padY}px ${CAP.padX}px`,
+          color: CAP.ink,
+          fontFamily: CAP.family,
+          fontWeight: CAP.weight,
+          fontSize: CAP.size,
+          lineHeight: `${CAP.line}px`,
+          letterSpacing: "-0.01em",
+          textAlign: "center",
+          whiteSpace: "pre",
+          fontKerning: "normal",
+        }}
+      >
+        {lines.map((line, li) => (
+          <div key={li} style={{ height: CAP.line, fontFamily: c.wordmarkLine === li ? CAP.wordmarkFamily : CAP.family }}>
+            {line.map((w, wi) => {
+              const wm = wordMotion(c, w, frame);
+              return (
+                <React.Fragment key={wi}>
+                  {wi > 0 ? " " : null}
+                  <span
+                    style={{
+                      display: "inline-block",
+                      opacity: wm.opacity,
+                      transform: wm.rise ? `translateY(${wm.rise}px)` : undefined,
+                      filter: wm.blur > 0.05 ? `blur(${wm.blur}px)` : undefined,
+                    }}
+                  >
+                    {w.text}
+                  </span>
+                </React.Fragment>
+              );
+            })}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+};
+
+export const Captions: React.FC<{ frame: number }> = ({ frame }) => {
+  const on = captionsAt(frame);
+  if (on.length === 0) return null;
+  const band = on.filter((c) => c.band !== "end");
+  const end = on.filter((c) => c.band === "end");
+  const k = endCreep(frame);
+  const [ox, oy] = LOCKUP_ORIGIN;
+  return (
+    <AbsoluteFill style={{ pointerEvents: "none" }}>
+      {band.map((c) => (
+        <CaptionView key={c.id} caption={c} frame={frame} />
+      ))}
+      {end.length > 0 && (
+        <AbsoluteFill style={{ transformOrigin: `${ox}px ${oy}px`, transform: `scale(${k})` }}>
+          {end.map((c) => (
+            <CaptionView key={c.id} caption={c} frame={frame} />
+          ))}
+        </AbsoluteFill>
+      )}
+    </AbsoluteFill>
+  );
+};
