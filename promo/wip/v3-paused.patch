+# Copies the app's real screens into public/screens/ (gitignored) for the film.
+#
+# v3 (the phone): the app's own composables rendered by app/src/test/java/com/poseit/app/promo/PromoScreens.kt at
+# 1200 x 2580 (app/build/promo-screens): promo-library(-tall).png, promo-detail.png, promo-camera(-saved).png (the
+# chrome's alpha solved by scripts/matte.py from its renders over black and over white), promo-viewer.png,
+# promo-icon.png. When they are missing this runs that test (needs the Android build: JDK 17+, the
+# SDK, Gradle's cache); with PROMO_SCREENS=render it re-renders them anyway.
+# v2: full-resolution captures from the app's screenshot tests (app/build/screenshots, 1200 x 2580); the committed
+# README screens (docs/images/screens, 560 px) are the fallback.
 set -euo pipefail
 cd "$(dirname "$0")/.."
 mkdir -p public/screens
+
+promo=../app/build/promo-screens
+need=(promo-library promo-library-tall promo-detail promo-camera-black promo-camera-white promo-camera-saved-black promo-camera-saved-white promo-viewer promo-icon)
+missing=0
+for f in "${need[@]}"; do [ -f "$promo/$f.png" ] || missing=1; done
+if [ "$missing" = 1 ] || [ "${PROMO_SCREENS:-}" = render ]; then
+  echo "assets: rendering the app's screens for the film (PromoScreens)"
+  (cd .. && ./gradlew --console=plain -q :app:testDebugUnitTest --tests 'com.poseit.app.promo.PromoScreens' --rerun) ||
+    echo "assets: PromoScreens could not run; the v3 demo needs its renders (see NOTE.md, 'Phone demo as built')"
+fi
+# the launch screen's icon: the 1024 px render when there is one, else the committed 256 px icon
+cp ../docs/images/icon.png public/screens/promo-icon.png
+if [ -d "$promo" ]; then
+  for f in "${need[@]}"; do [ -f "$promo/$f.png" ] && cp "$promo/$f.png" public/screens/; done
+  [ -f "$promo/promo-screens.json" ] && cp "$promo/promo-screens.json" public/screens/
+  # the camera chrome over a transparent preview, from its renders over black and over white
+  for f in promo-camera promo-camera-saved; do
+    [ -f "$promo/$f-black.png" ] && [ -f "$promo/$f-white.png" ] && python3 scripts/matte.py "$promo/$f-black.png" "$promo/$f-white.png" "public/screens/$f.png"
+  done
+fi
+
 src=../app/build/screenshots
 if [ -d "$src" ]; then
   for f in library detail camera-hud onboarding editor_from_pose settings review-camera-timer-running; do
