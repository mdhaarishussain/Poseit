+/**
+ * The app's real screens for the promo film v3 (promo/STORYBOARD.md v3, section 13), rendered on the JVM from the
+ * app's own composables at the phone screen the film draws (400 x 860 dp at xxhdpi = 1200 x 2580 px) into
+ * app/build/promo-screens/. promo/scripts/assets.sh copies them into promo/public/screens/ (gitignored).
+ *
+ *  - promo-library.png         LibraryScreen as it opens (the camera button expanded)
+ *  - promo-library-tall.png    the same screen 1720 dp tall (1200 x 5160): its grid is the content the film scrolls
+ *                              under the fixed top bar (the scroll motion itself is the film's, not captured)
+ *  - promo-detail.png          PoseDetailScreen for "Hands in pockets" (stand_hands_in_pockets)
+ *  - promo-camera-{black,white}.png  the camera screen's chrome as CameraContent lays it out, back camera, 9:16, grid
+ *                              off, "Hands in pockets" selected in the pose strip, with the preview left EMPTY, once over
+ *                              black and once over white: promo/scripts/matte.py solves the chrome's alpha from the pair
+ *                              (promo-camera.png), so the film puts the live view and the HUD under the translucent
+ *                              control scrim exactly as the app composes them
+ *  - promo-camera-saved-{black,white}.png  the same after a capture: the snackbar "Saved to Pictures/Poseit" with
+ *                              "View" (shown indefinitely here; the app shows it for SnackbarDuration.Short)
+ *  - promo-viewer.png          PhotoViewer on one photo (the photo itself cannot load on the JVM: the film draws the
+ *                              captured frame over its photo area)
+ *  - promo-icon.png            the launcher icon flat at 1024 px (as RepoAssetsTest.icon), for the launch screen
+ *  - promo-screens.json        the layout the film needs from these renders (px bounds of the tapped tile, the title,
+ *                              the button, the preview, the controls, the gallery thumbnail, the snackbar)
+ *
+ * Run: ./gradlew :app:testDebugUnitTest --tests 'com.poseit.app.promo.PromoScreens'  (promo: npm run assets)
+ */
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = [35], qualifiers = "en-rGB-w400dp-h860dp-xxhdpi")
+class PromoScreens {
+
+    @get:Rule
+    val compose = createComposeRule()
+
+    private val out = File("build/promo-screens").apply { mkdirs() }
+
+    private fun render(name: String, ready: String? = null, content: @Composable () -> Unit) {
+        compose.setContent { PoseitTheme { content() } }
+        compose.waitForIdle()
+        if (ready != null) {
+            compose.waitUntil(15_000) {
+                compose.onAllNodesWithText(ready, substring = true, useUnmergedTree = true).fetchSemanticsNodes().isNotEmpty()
+            }
+            compose.waitForIdle()
+        }
+        compose.onRoot().captureRoboImage("build/promo-screens/$name.png")
+    }
+
+    private fun screen(name: String, ready: String, content: @Composable () -> Unit) = render(name, ready) {
+        Box(Modifier.fillMaxSize().background(MaterialTheme.colorScheme.background)) { content() }
+    }
+
+    private fun node(m: SemanticsMatcher, unmerged: Boolean = false): SemanticsNode =
+        compose.onAllNodes(m, useUnmergedTree = unmerged).fetchSemanticsNodes().first()
+
+    private fun Rect.json() = String.format(Locale.US, "{\"x\":%.1f,\"y\":%.1f,\"w\":%.1f,\"h\":%.1f}", left, top, width, height)
+
+    private fun record(name: String, vararg entries: Pair<String, Rect>) {
+        layout[name] = entries.joinToString(",", "{", "}") { (k, r) -> "\"$k\":${r.json()}" }
+    }
+
+    @After
+    fun writeLayout() {
+        // One test class instance per test: merge into the file on disk.
+        val f = File(out, "promo-screens.json")
+        val existing = if (f.exists()) Regex("\"([a-z-]+)\": (\\{.*\\})").findAll(f.readText()).associate { it.groupValues[1] to it.groupValues[2] } else emptyMap()
+        val all = (existing + layout).toSortedMap()
+        f.writeText(all.entries.joinToString(",\n", "{\n", "\n}\n") { (k, v) -> "  \"$k\": $v" })
+    }
+
+    private val layout = mutableMapOf<String, String>()
+
+    // ------------------------------------------------------------------------------------------------ the library
+
+    private fun libraryBounds(name: String) {
+        val tile = node(hasText(PICK_NAME) and hasClickAction()).boundsInRoot
+        val other = node(hasText("Hand on hip") and hasClickAction()).boundsInRoot
+        val count = node(hasText("99 poses"), unmerged = true).boundsInRoot
+        val fab = compose.onAllNodes(hasText("Pose camera") or hasContentDescription("Pose camera"), useUnmergedTree = true)
+            .fetchSemanticsNodes().firstOrNull()?.boundsInRoot ?: Rect.Zero
+        val search = node(hasText("Search", substring = true), unmerged = true).boundsInRoot
+        record(name, "pick" to tile, "first" to other, "count" to count, "fab" to fab, "search" to search)
+    }
+
+    @Test
+    fun library() {
+        screen("promo-library", ready = "99 poses") { LibraryScreen({}, {}, {}, {}, {}, {}) }
+        libraryBounds("library")
+    }
+
+    @Test
+    @Config(qualifiers = "en-rGB-w400dp-h1720dp-xxhdpi")
+    fun libraryTall() {
+        screen("promo-library-tall", ready = "99 poses") { LibraryScreen({}, {}, {}, {}, {}, {}) }
+        libraryBounds("library-tall")
+    }
+
+    // ------------------------------------------------------------------------------------------------- the pose page
+
+    @Test
+    fun detail() {
+        screen("promo-detail", ready = "How to do it") {
+            PoseDetailScreen(poseId = PICK, onBack = {}, onTryPose = { _, _ -> }, onEdit = {})
+        }
+        val title = node(hasText(PICK_NAME), unmerged = true).boundsInRoot
+        val button = node(hasText("Try this pose") and hasClickAction()).boundsInRoot
+        record("detail", "title" to title, "try" to button)
+    }
+
+    // ------------------------------------------------------------------------------------------------- the camera
+
+    /**
+     * CameraContent's layout with the camera's own pieces (the top bar, the pose strip, the shutter row, the snackbar
+     * host), as RepoAssetsTest.CameraStill builds it, at the film's settings: back camera, 9:16, grid off, no timer,
+     * "Hands in pockets" selected. The preview box is left empty and nothing paints the screen behind it, so it is
+     * the background the render puts behind it (black or white, for the matte). The HUD (guide, skeleton, ring, card, countdown) is the film's, from the app's
+     * verdicts on the footage (promo/src/scenes/viewfinder).
+     */
+    @Composable
+    private fun CameraChrome(saved: Boolean, onPreview: (Rect) -> Unit, onControls: (Rect) -> Unit) {
+        val pose = BuiltInPoses.byId(PICK)!!
+        val aspect = SceneAspect.RATIO_9_16
+        val strip = remember(pose) { buildStripPoses(BuiltInPoses.all, emptySet(), pose.category, pose) }
+        val snackbar = remember { SnackbarHostState() }
+        if (saved) {
+            LaunchedEffect(Unit) { snackbar.showSnackbar("Saved to Pictures/Poseit", actionLabel = "View", duration = SnackbarDuration.Indefinite) }
+        }
+        Column(Modifier.fillMaxSize()) {
+            CameraTopBar(
+                flash = FlashMode.OFF, hasFlash = true, grid = GridType.NONE, aspect = aspect, timer = TimerOption.Off,
+                onBack = {}, onFlash = {}, onGrid = {}, onAspect = {}, onTimer = {}, onPhotoshoot = {}, onQuickSettings = {},
+            )
+            BoxWithConstraints(Modifier.fillMaxWidth().weight(1f)) {
+                val density = LocalDensity.current
+                var controlsHeightPx by remember { mutableIntStateOf(0) }
+                val controlsHeight = with(density) { controlsHeightPx.toDp() }
+                val previewWidth = min(maxWidth, maxHeight * aspect.ratio)
+                val previewHeight = previewWidth / aspect.ratio
+                val free = maxHeight - controlsHeight
+                val previewTop = if (previewHeight <= free) (free - previewHeight) / 2 else 0.dp
+                Box(
+                    Modifier
+                        .align(Alignment.TopCenter)
+                        .offset(y = previewTop)
+                        .width(previewWidth)
+                        .aspectRatio(aspect.ratio)
+                        .clipToBounds()
+                        .onGloballyPositioned { onPreview(it.boundsInRoot()) },
+                )
+                Column(
+                    Modifier
+                        .align(Alignment.BottomCenter)
+                        .fillMaxWidth()
+                        .onSizeChanged { controlsHeightPx = it.height }
+                        .onGloballyPositioned { onControls(it.boundsInRoot()) }
+                        .background(Studio.ControlScrim)
+                        .padding(top = Space.m),
+                ) {
+                    PoseStrip(poses = strip, selectedId = pose.id, favorites = emptySet(), onSelect = {}, onOpenAll = {})
+                    ShutterRow(
+                        lastPhoto = null, sessionActive = false, timer = TimerOption.Off, capturing = false,
+                        onGallery = {}, onShutter = {}, onFlip = {},
+                    )
+                }
+                StudioSnackbarHost(snackbar, Modifier.align(Alignment.BottomCenter).padding(bottom = controlsHeight))
+            }
+        }
+    }
+
+    private fun camera(name: String, saved: Boolean, behind: Color) {
+        var preview = Rect.Zero
+        var controls = Rect.Zero
+        val suffix = if (behind == Color.Black) "black" else "white"
+        render("$name-$suffix", ready = if (saved) "Saved to" else PICK_NAME_STRIP) {
+            Box(Modifier.fillMaxSize().background(behind)) { CameraChrome(saved, { preview = it }, { controls = it }) }
+        }
+        val gallery = node(hasContentDescription("Open gallery"), unmerged = true).boundsInRoot
+        val shutter = node(hasContentDescription("Take photo"), unmerged = true).boundsInRoot
+        val entries = mutableListOf("preview" to preview, "controls" to controls, "gallery" to gallery, "shutter" to shutter)
+        if (saved) entries += "snackbar" to node(hasText("Saved to", substring = true), unmerged = true).boundsInRoot
+        record(name.removePrefix("promo-"), *entries.toTypedArray())
+    }
+
+    @Test
+    fun cameraOverBlack() = camera("promo-camera", saved = false, behind = Color.Black)
+
+    @Test
+    fun cameraOverWhite() = camera("promo-camera", saved = false, behind = Color.White)
+
+    @Test
+    fun cameraSavedOverBlack() = camera("promo-camera-saved", saved = true, behind = Color.Black)
+
+    @Test
+    fun cameraSavedOverWhite() = camera("promo-camera-saved", saved = true, behind = Color.White)
+
+    // ------------------------------------------------------------------------------------------------- the photo
+
+    @Test
+    fun viewer() {
+        val photo = SavedPhoto(
+            uri = Uri.parse("content://media/external/images/media/1"),
+            displayName = "Poseit_1.jpg",
