+/**
+ * PhoneDemo.tsx: B3-B6, f160-560 (STORYBOARD.md v3, BUILDER APP). The app on the phone, in the app's own order:
+ * pick a pose, match the outline, it tells you what to fix, hold still, it takes the photo, here's your photo.
+ *
+ *   <PhoneDemo frame={global v3 frame} />   (Promo.tsx: ACTS_V3.demo; the caption layer sits over it)
+ *
+ *   f160-172  the launch screen (STORY's last frame, PHONE_FRAMING.W2.to) gives way to the library; push W2 -> M
+ *   f176-214  a finger drags the library up and lets go; it flings and settles with "Hands in pockets" mid-frame
+ *   f216-221  the finger parks on "Hands in pockets", presses (2 f), the tile ripples a frame later
+ *   f222-232  the app's navigation to the pose page; f228-240 push D1 ("Hands in pockets" reads at 0.048 H); the
+ *             room swaps to her studio at f240 while the screen covers the frame
+ *   f246-258  pull back to D2; f256-261 the finger taps "Try this pose"; f262-272 the camera opens; f264-284 pull
+ *             back to W3, the phone standing in her studio
+ *   f272-472  the camera screen: the app's chrome over the live preview (Viewfinder.tsx LivePreview: the plate at its
+ *             v2 frame, the guide, her skeleton, the ring, the card, the countdown, all from the app's verdicts).
+ *             f312-330 push to C (the card "Bend your right elbow more" at 0.035 H); f361 the lock steps 1.5%;
+ *             f382-402 pull back to W3 on the "3"; 3/2/1 at f382/412/442; f472 the app's capture flash
+ *   f472-480  the shutter's disc dips to 0.88 while the app captures (ShutterButton's `capturing`; nobody touches it)
+ *   f480      the photo lands in the gallery thumbnail; "Saved to Pictures/Poseit" rises
+ *   f484-494  the photo opens from the thumbnail into the photo viewer, in colour (the film's first colour)
+ *   f490-516  push PHOTO until the photo fills the frame; then a slow push 1.00 -> 1.06 about her mid-hip to the cut
+ *
+ * Real, rebuilt, illustrative: NOTE.md "Phone demo as built (v3)".
+ */
+import React from "react";
+import { AbsoluteFill } from "remotion";
+import { theme } from "../theme";
+import { tween } from "../motion";
+import { FilmGrain } from "../world/Grain";
+import { Device } from "../phone/Device";
+import { Room } from "../phone/Room";
+import { LaunchScreen } from "../phone/screens/LaunchScreen";
+import { CameraScreen, DetailScreen, LibraryScreen, PlateBox, TouchDisc, ViewerChrome } from "../phone/screens/AppScreens";
+import { DETAIL } from "../phone/screens/layout";
+import { CapturedPhoto, type LivePreviewOptions } from "./Viewfinder";
+import { DEMO_V3 } from "./timing";
+import { demoRectAt, librarySplash, libraryScroll, photoBoxAt, screenOpacities, tileRipple, touchAt, tryRipple } from "./demo/timeline";
+
+const E = theme.ease;
+const T = DEMO_V3;
+
+/**
+ * The HUD inside the phone (declared, NOTE.md): v2's camera HUD in the preview, the card magnified 1.1x more so it
+ * reads at 0.035 H with the phone pushed in (C), the ring at 0.75 of v2's (v2's is 1.9x the app's 56 dp; in the
+ * phone it sits next to the app's own chrome), the countdown as v2 (its glyph 0.058 H at W3).
+ */
+export const DEMO_HUD: LivePreviewOptions = { cardMag: 1.1, ringMag: 0.75, countdownMag: 1 };
+
+const Screen: React.FC<{ frame: number }> = ({ frame }) => {
+  const o = screenOpacities(frame);
+  const splash = librarySplash(frame);
+  const touch = touchAt(frame);
+  const showLibrary = frame < T.detailOpen[1];
+  const showDetail = frame >= T.detailOpen[0] && frame < T.cameraOpen[1];
+  const showCamera = frame >= T.cameraOpen[0] && frame < T.viewerOpen[1];
+  const showViewer = frame >= T.viewerOpen[0];
+  const photo = photoBoxAt(frame);
+  return (
+    <>
+      {showLibrary && <LibraryScreen scroll={libraryScroll(frame)} ripple={tileRipple(frame)} />}
+      {splash > 0.002 && (
+        <div style={{ position: "absolute", inset: 0, opacity: splash }}>
+          <LaunchScreen iconScale={1 + 0.08 * (1 - splash)} iconOpacity={1 - tween(frame, [T.launchToLibrary[0], T.launchToLibrary[0] + 5], [0, 1], E.softInOut)} />
+        </div>
+      )}
+      {showDetail && (
+        <div style={{ position: "absolute", inset: 0, opacity: o.detail }}>
+          <DetailScreen ripple={tryRipple(frame)} rippleRect={DETAIL.tryButton} />
+        </div>
+      )}
+      {showCamera && (
+        <div style={{ position: "absolute", inset: 0, opacity: o.camera }}>
+          <CameraScreen
+            frame={frame}
+            live={DEMO_HUD}
+            thumb={tween(frame, [T.thumb, T.thumb + 4], [0, 1], E.softInOut)}
+            snackbar={tween(frame, [T.thumb, T.thumb + 5], [0, 1], E.softLand)}
+            shutterScale={frame < T.thumb ? tween(frame, [T.flash[0], T.flash[0] + 4.5], [1, 0.88], E.glide) : tween(frame, [T.thumb, T.thumb + 4.5], [0.88, 1], E.glide)}
+          />
+        </div>
+      )}
+      {showViewer && (
+        <>
