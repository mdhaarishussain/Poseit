+/**
+ * LaunchScreen.tsx: B2's screen and the start of B3, the Android launch screen of Poseit: the app has no splash theme
+ * of its own, so Android 12+ shows its launcher icon (beats.ts PHONE.splashIcon: 0.40 of the screen width, centred)
+ * on the window background, Studio Paper.
+ *
+ *   <LaunchScreen iconScale={1} iconOpacity={1} />   inside <Device>; STORY lands the icon from 2.6x (OPENING_V3)
+ *
+ * The icon is the app's own (RepoAssetsTest's icon render, cut to the launcher disc): public/screens/promo-icon.png,
+ * copied by `npm run assets` (the 1024 px render from PromoScreens.kt when the app's tests have run, else
+ * docs/images/icon.png at 256 px).
+ */
+import React from "react";
+import { Img, staticFile } from "remotion";
+import { PHONE } from "../../beats";
+import { theme } from "../../theme";
+import { SCREEN } from "../framing";
+
+export const LAUNCH_ICON_SRC = "screens/promo-icon.png";
+
+/** The icon's centre and diameter in screen px (1200 x 2580). */
+export const LAUNCH_ICON = { cx: SCREEN.w / 2, cy: PHONE.splashIcon.cy * SCREEN.h, d: PHONE.splashIcon.d * SCREEN.w } as const;
+
+export const LaunchScreen: React.FC<{ iconScale?: number; iconOpacity?: number; blur?: number }> = ({ iconScale = 1, iconOpacity = 1, blur = 0 }) => {
+  const d = LAUNCH_ICON.d;
+  return (
+    <div style={{ position: "absolute", inset: 0, background: theme.color.paper }}>
+      <Img
+        src={staticFile(LAUNCH_ICON_SRC)}
+        style={{
+          position: "absolute",
+          left: LAUNCH_ICON.cx - d / 2,
+          top: LAUNCH_ICON.cy - d / 2,
+          width: d,
+          height: d,
+          borderRadius: "50%",
+          opacity: iconOpacity,
+          transform: `scale(${iconScale})`,
+          filter: blur > 0.05 ? `blur(${blur}px)` : undefined,
+        }}
+      />
+    </div>
+  );
+};
