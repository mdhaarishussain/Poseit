+/**
+ * CaptionPreview.tsx (dev only, BUILDER APP): a static stand-in for STORY's caption layer, laid out from beats.ts
+ * CAPTIONS and CAPTION_SYSTEM (card, size, bands), so the demo's stills show where the captions sit while the real
+ * layer (src/captions) is being built. Not part of the film.
+ */
+import React from "react";
+import { AbsoluteFill } from "remotion";
+import { CAPTIONS, CAPTION_SYSTEM } from "../../beats";
+import { theme } from "../../theme";
+
+const { W, H } = theme.size;
+const S = CAPTION_SYSTEM;
+
+export const CaptionPreview: React.FC<{ frame: number }> = ({ frame }) => {
+  const c = CAPTIONS.find((x) => frame >= x.from && frame < x.to);
+  if (!c || c.band === "end") return null;
+  const lineH = S.font.lineH * H;
+  const padY = S.card.padYH * H;
+  const cardH = c.lines.length * lineH + 2 * padY;
+  const top = c.band === "top" ? S.bands.topCardTopH * H : S.bands.bottomCardBottomH * H - cardH;
+  return (
+    <AbsoluteFill>
+      <div style={{ position: "absolute", left: 0, width: W, top, display: "flex", justifyContent: "center" }}>
+        <div
+          style={{
+            background: S.card.fill,
+            color: S.card.ink,
+            borderRadius: S.card.radiusW * W,
+            padding: `${padY}px ${S.card.padXW * W}px`,
+            fontFamily: S.font.family,
+            fontWeight: S.font.weight,
+            fontSize: S.font.sizeH * H,
+            lineHeight: `${lineH}px`,
+            textAlign: "center",
+            whiteSpace: "nowrap",
+          }}
+        >
+          {c.lines.map((l, i) => (
+            <div key={i} style={c.wordmarkLine === i ? { fontFamily: S.font.wordmarkFamily } : undefined}>
+              {l}
+            </div>
+          ))}
+        </div>
+      </div>
+    </AbsoluteFill>
+  );
+};
