+/**
+ * DevRoot.tsx (dev only, BUILDER APP): compositions to look at the phone demo before the v3 film is assembled.
+ *   AppDemo   1080 x 1920, 816 f: f0-160 a stand-in opening built from src/phone (STORY builds the real one in
+ *             scenes/Opening.tsx), f160-560 PhoneDemo, the static caption stand-in on top.
+ * Render: npx remotion still src/scenes/demo/dev-index.ts AppDemo out/app-<n>.png --frame N --scale 0.5
+ */
+import React from "react";
+import { AbsoluteFill, Composition, useCurrentFrame } from "remotion";
+import { FILM_V3 } from "../../beats";
+import { theme } from "../../theme";
+import { ensureFonts } from "../../fonts";
+import { Device, LaunchScreen, PlainCamera, Room, screenRectAt } from "../../phone";
+import { tween } from "../../motion";
+import { PhoneDemo } from "../PhoneDemo";
+import { CaptionPreview } from "./CaptionPreview";
+
+ensureFonts();
+
+const OpeningStandIn: React.FC<{ frame: number }> = ({ frame }) => (
+  <AbsoluteFill>
+    <Room frame={frame} />
+    <Device rect={screenRectAt(frame)}>
+      {frame < 96 ? <PlainCamera frame={frame} /> : <LaunchScreen iconScale={tween(frame, [96, 104], [2.6, 1], theme.ease.softLand)} />}
+    </Device>
+  </AbsoluteFill>
+);
+
+const AppDemo: React.FC = () => {
+  const frame = useCurrentFrame();
+  return (
+    <AbsoluteFill style={{ background: theme.color.paper }}>
+      {frame < 160 && <OpeningStandIn frame={frame} />}
+      {frame >= 160 && frame < 560 && <PhoneDemo frame={frame} />}
+      <CaptionPreview frame={frame} />
+    </AbsoluteFill>
+  );
+};
+
+export const DevRoot: React.FC = () => (
+  <Composition id="AppDemo" component={AppDemo} width={FILM_V3.width} height={FILM_V3.height} fps={FILM_V3.fps} durationInFrames={FILM_V3.frames} />
+);
