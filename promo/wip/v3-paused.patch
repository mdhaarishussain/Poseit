+/**
+ * PlainCamera.tsx: B1's screen, a phone's plain camera before Poseit is opened (STORYBOARD.md v3 B1). No brand and no
+ * Poseit chrome: a black band at the top (0.05 of the screen height), the live picture full width, a black band at the
+ * bottom (0.14) with a white shutter ring (0.18 of the screen width), an empty gallery square and a camera-flip disc.
+ * Nobody presses the shutter.
+ *
+ *   <PlainCamera frame={global v3 frame} plate="o1" />   inside <Device>; the plate plays on its own clock, printed
+ *                                                        in the Studio ramp (grey until the shutter)
+ * Layout constants are exported (PLAIN_CAMERA) so the opening can place things relative to the picture.
+ */
+import React from "react";
+import { theme } from "../../theme";
+import { Footage } from "../../footage/Footage";
+import { SCREEN } from "../framing";
+
+const { W, H } = theme.size;
+
+export const PLAIN_CAMERA = {
+  topBand: 0.05 * SCREEN.h,
+  bottomBand: 0.14 * SCREEN.h,
+  shutterD: 0.18 * SCREEN.w,
+  /** the picture: the 9:16 plate at the screen's full width */
+  picture: { x: 0, y: 0.05 * SCREEN.h, w: SCREEN.w, h: (SCREEN.w * H) / W },
+} as const;
+
+const C = PLAIN_CAMERA;
+
+export const PlainCamera: React.FC<{ frame: number; plate?: string; freezeAt?: number }> = ({ frame, plate = "o1", freezeAt }) => {
+  const s = C.picture.w / W;
+  const bandTop = SCREEN.h - C.bottomBand;
+  const cy = bandTop + C.bottomBand / 2;
+  const ring = C.shutterD;
+  const side = 0.1 * SCREEN.w;
+  return (
+    <div style={{ position: "absolute", inset: 0, background: theme.color.liveView }}>
+      <div style={{ position: "absolute", left: C.picture.x, top: C.picture.y, width: W, height: H, transformOrigin: "0 0", transform: `scale(${s})` }}>
+        <Footage id={plate} frame={frame} look="duotone" freezeAt={freezeAt} />
+      </div>
+      <div style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: C.topBand, background: theme.color.liveView }} />
+      <div style={{ position: "absolute", left: 0, top: bandTop, width: SCREEN.w, height: C.bottomBand, background: theme.color.liveView }} />
+      {/* shutter: a white ring around a white disc */}
+      <div
+        style={{
+          position: "absolute",
+          left: SCREEN.w / 2 - ring / 2,
+          top: cy - ring / 2,
+          width: ring,
+          height: ring,
+          borderRadius: "50%",
+          boxShadow: `inset 0 0 0 ${ring * 0.06}px ${theme.color.mannequin}`,
+        }}
+      />
+      <div
+        style={{
+          position: "absolute",
+          left: SCREEN.w / 2 - ring * 0.37,
+          top: cy - ring * 0.37,
+          width: ring * 0.74,
+          height: ring * 0.74,
+          borderRadius: "50%",
+          background: theme.color.mannequin,
+        }}
+      />
+      {/* an empty gallery square (left) and the camera-flip disc (right), generic */}
+      <div style={{ position: "absolute", left: SCREEN.w * 0.2 - side / 2, top: cy - side / 2, width: side, height: side, borderRadius: side * 0.22, background: "#2B2C2E" }} />
+      <div style={{ position: "absolute", left: SCREEN.w * 0.8 - side / 2, top: cy - side / 2, width: side, height: side, borderRadius: "50%", background: "#2B2C2E" }} />
+    </div>
+  );
+};
