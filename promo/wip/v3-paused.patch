@@ -0,0 +1,152 @@
+/**
+ * demo/timeline.ts: what happens on the phone in B3-B6 (f160-560), frame by frame. Pure, no React, so a script or a
+ * check can read it. Frames are timing.ts DEMO_V3 and beats.ts LIVE_V3 (the app's verdicts); positions are px in the
+ * app's 1200 x 2580 screen renders (phone/screens/layout.ts).
+ *
+ *   librarySplash(f)    0..1: the launch screen still over the library (Android's splash exit, f160-170)
+ *   libraryScroll(f)    px the library's grid has scrolled: a finger drag f176-184, then a fling decaying to f214,
+ *                       settling with "Hands in pockets" in the middle third of the frame
+ *   touchAt(f)          the fingertip: { x, y, opacity, squash } or null (the drag, the tap on the tile, the tap on
+ *                       "Try this pose")
+ *   tileRipple(f), tryRipple(f)  the pressed ripple on the tile and the button
+ *   screenOpacities(f)  { library, detail, camera, viewer }: the app's navigation, crossfades (f222-232, f262-272)
+ *   demoRectAt(f)       the phone's screen rect: framing.ts screenRectAt + the lock's 1.5% step (f361, given back
+ *                       during the pull back) + the photo's slow push (f516 on, 1.00 -> 1.06 about her mid-hip)
+ *   photoOpen(f)        0..1: the photo growing from the gallery thumbnail into the viewer (f484-494)
+ */
+import { DEMO_V3 } from "../timing";
+import { LIVE_V3, type ScreenRect } from "../../beats";
+import { theme } from "../../theme";
+import { drift, snapTail, tween } from "../../motion";
+import { scaleRectAbout, screenRectAt, screenToFilm } from "../../phone/framing";
+import { CAMERA, DETAIL, LIBRARY, VIEWER } from "../../phone/screens/layout";
+import { PHOTO_HIP } from "../Viewfinder";
+
+const E = theme.ease;
+const { W, H } = theme.size;
+const T = DEMO_V3;
+
+// ---- the library -------------------------------------------------------------------------------------------------
+
+export const librarySplash = (f: number) => 1 - tween(f, [T.launchToLibrary[0], T.launchToLibrary[1] - 2], [0, 1], E.softInOut);
+
+/**
+ * Where the tile's image centre must land on screen (px) at the end of the scroll: 0.547 H in the frame at the M
+ * framing (the frame's middle third), so "99 poses" sits under the top bar and the next row shows below.
+ */
+const TILE_CY = LIBRARY.pickTile.y + LIBRARY.pickTile.h / 2;
+const M_TO = { s: (0.68 * W) / 1200, top: 0.29 * H };
+const TARGET_Y = (0.547 * H - M_TO.top) / M_TO.s;
+export const SCROLL_TO = Math.round(TILE_CY - TARGET_Y);
+
+/** A fling: the finger's drag eases in (u^1.25), then the content decays exponentially (k 4.5) to rest. */
+const fling = (u: number) => {
+  const k = 4.5;
+  const v = Math.pow(Math.min(1, Math.max(0, u)), 1.25);
+  return (1 - Math.exp(-k * v)) / (1 - Math.exp(-k));
+};
+export const libraryScroll = (f: number) => {
+  const [a, b] = T.scroll;
+  return SCROLL_TO * fling((f - a) / (b - a));
+};
+
+/** The finger lifts here: the drag is over, the fling carries on. */
+const LIFT = T.scroll[0] + 8;
+/** the drag starts in the gutter between the two columns, not on a tile (it is not a tap) */
+const DRAG_FROM = { x: 600, y: 1900 };
+
+// ---- taps ----------------------------------------------------------------------------------------------------------
+
+type Tap = { park: number; press: number; answer: number };
+type Pt = { x: number; y: number };
+
+export const TILE_TAP: Pt = { x: LIBRARY.pickTile.x + LIBRARY.pickTile.w / 2, y: TILE_CY - SCROLL_TO };
+export const TRY_TAP: Pt = { x: DETAIL.tryButton.x + DETAIL.tryButton.w * 0.45, y: DETAIL.tryButton.y + DETAIL.tryButton.h / 2 };
+
+/** A tap: the finger comes in from below-right (6 f, softLand), parks, squashes for 2 f on the press, lifts. */
+const tapTouch = (f: number, tap: Tap, at: Pt) => {
+  const enter = tap.park - 6;
+  if (f < enter || f >= tap.answer + 5) return null;
+  const k = tween(f, [enter, tap.park], [1, 0], E.softLand);
+  const opacity = f < tap.press + 2 ? tween(f, [enter, enter + 3], [0, 1], E.softInOut) : tween(f, [tap.press + 2, tap.answer + 5], [1, 0], E.softInOut);
+  const squash = f >= tap.press && f < tap.press + 2 ? 0.9 : 1;
+  return { x: at.x + 70 * k, y: at.y + 120 * k, opacity, squash };
+};
+
+export const touchAt = (f: number) => {
+  // the drag that starts the fling
+  if (f >= T.scroll[0] - 4 && f < LIFT + 4) {
+    const opacity = f < LIFT ? tween(f, [T.scroll[0] - 4, T.scroll[0]], [0, 1], E.softInOut) : tween(f, [LIFT, LIFT + 4], [1, 0], E.softInOut);
+    const y = DRAG_FROM.y - libraryScroll(Math.min(f, LIFT));
+    return { x: DRAG_FROM.x, y, opacity, squash: f < T.scroll[0] ? 0.95 : 1 };
+  }
+  return tapTouch(f, T.tapTile, TILE_TAP) ?? tapTouch(f, T.tapTry, TRY_TAP);
+};
+
+/** The Material ripple: grows over 7 f from a frame after the press (the app's answer), fades from the lift. */
+const ripple = (f: number, tap: Tap, at: Pt, alpha: number) => {
+  if (f < tap.answer || f > tap.answer + 14) return null;
+  return {
+    x: at.x,
+    y: at.y,
+    t: tween(f, [tap.answer, tap.answer + 7], [0, 1], E.softLand),
+    alpha: alpha * tween(f, [tap.answer + 4, tap.answer + 14], [1, 0], E.softInOut),
+  };
+};
+/** on the tile the ripple is in content coordinates (it scrolls with the grid) */
+export const tileRipple = (f: number) => ripple(f, T.tapTile, { x: TILE_TAP.x, y: TILE_CY }, 0.12);
+export const tryRipple = (f: number) => ripple(f, T.tapTry, TRY_TAP, 0.22);
+
+// ---- navigation ----------------------------------------------------------------------------------------------------
+
+export const screenOpacities = (f: number) => {
+  const detail = tween(f, T.detailOpen, [0, 1], E.softInOut);
+  const camera = tween(f, T.cameraOpen, [0, 1], E.softInOut);
+  const viewer = tween(f, T.viewerOpen, [0, 1], E.softInOut);
+  return { library: 1, detail, camera, viewer };
+};
+
+/** 0..1: the photo grows from the gallery thumbnail into the viewer's photo box. */
+export const photoOpen = (f: number) => tween(f, T.viewerOpen, [0, 1], E.softLand);
+
+/** The photo's box (screen px) and corner radius while it opens. */
+export const photoBoxAt = (f: number) => {
+  const t = photoOpen(f);
+  const ring = 4.5;
+  const g = { x: CAMERA.gallery.x + ring, y: CAMERA.gallery.y + ring, w: CAMERA.gallery.w - 2 * ring, h: CAMERA.gallery.h - 2 * ring };
+  const v = VIEWER.photo;
+  const mix = (a: number, b: number) => a + (b - a) * t;
+  return { rect: { x: mix(g.x, v.x), y: mix(g.y, v.y), w: mix(g.w, v.w), h: mix(g.h, v.h) }, radius: mix(g.w / 2, 0) };
+};
+
+// ---- the phone's framing -------------------------------------------------------------------------------------------
+
+/** The lock's step scales about her chest (scene 0.5, 0.5) on the screen, so the card and the figure stay put. */
+const STEP_PT = { x: CAMERA.preview.x + 0.5 * CAMERA.preview.w, y: CAMERA.preview.y + 0.5 * CAMERA.preview.h };
+
+const lockStep = (f: number) => {
+  if (f < T.lockStep) return 1;
+  const s = snapTail(f, T.lockStep, { from: 1, snap: 1.01, to: 1.015, tail: 8 });
+  // given back with the pull back (C -> W3), so the framing lands on W3 exactly
+  return f < T.pullW[0] ? s : 1 + (s - 1) * (1 - tween(f, T.pullW, [0, 1], E.softLand));
+};
+
+/** Her mid-hip on the viewer's photo, in screen px. */
+const HIP_ON_SCREEN: [number, number] = [VIEWER.photo.x + PHOTO_HIP[0] * VIEWER.photo.w, VIEWER.photo.y + PHOTO_HIP[1] * VIEWER.photo.h];
+
+export const demoRectAt = (f: number): ScreenRect => {
