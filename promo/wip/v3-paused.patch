+        Box(Modifier.fillMaxSize().clip(CircleShape).background(Studio.Set), contentAlignment = Alignment.Center) {
+            Image(
+                painterResource(R.drawable.ic_launcher_foreground),
+                contentDescription = null,
+                modifier = Modifier.requiredSize(256.dp * 108f / 72f),
+            )
+        }
+    }
+
+    private companion object {
