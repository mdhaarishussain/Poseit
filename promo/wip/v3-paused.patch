index 0000000..934d1a6
--- /dev/null
+++ b/promo/src/phone/screens/AppScreens.tsx
@@ -0,0 +1,171 @@
+/**
+ * AppScreens.tsx: the app's real screens inside the phone (B3-B6), each laid out in the 1200 x 2580 screen box of
+ * <Device>. The pictures are the app's own Compose screens rendered by PromoScreens.kt (layout.ts SRC); what moves
+ * on them (the scroll, the ripple, a finger, the snackbar arriving, the photo opening) is the film's, close to the
+ * app's (NOTE.md, "Phone demo as built").
+ *
+ *   <LibraryScreen scroll ripple? />         LibraryScreen: the grid (the tall render) scrolled `scroll` px under the
+ *                                            fixed top bar; the "Pose camera" button stays put
+ *   <DetailScreen ripple? />                 PoseDetailScreen for "Hands in pockets"
+ *   <CameraScreen frame live? thumb snackbar /> the camera chrome over the live preview (Viewfinder.tsx LivePreview)
+ *   <ViewerChrome />                         PhotoViewer's page (black, the bars) without its photo
+ *   <PlateBox rect radius>                   a 1080 x 1920 canvas (a plate) cover-fitted into a rect: the photo
+ *   <Ripple rect radius at p color />        Material's pressed ripple, bounded to a rounded rect
+ *   <TouchDisc x y opacity squash />         a fingertip (beats.ts PHONE.touch): an Ink disc at 22% with a 45% ring
+ */
+import React from "react";
+import { Img, staticFile } from "remotion";
+import { PHONE } from "../../beats";
+import { theme } from "../../theme";
+import { CapturedPhoto, LivePreview, type LivePreviewOptions } from "../../scenes/Viewfinder";
+import { SCREEN } from "../framing";
+import { CAMERA, LIBRARY, SRC, type PxRect } from "./layout";
+
+const { W, H } = theme.size;
+
+/** A 1080 x 1920 canvas (the 9:16 scene) cover-fitted into `rect` (screen px), clipped to `radius`. */
+export const PlateBox: React.FC<{ rect: PxRect; radius?: number; children: React.ReactNode; style?: React.CSSProperties }> = ({ rect, radius = 0, children, style }) => {
+  const s = Math.max(rect.w / W, rect.h / H);
+  return (
+    <div style={{ position: "absolute", left: rect.x, top: rect.y, width: rect.w, height: rect.h, overflow: "hidden", borderRadius: radius, ...style }}>
+      <div style={{ position: "absolute", left: (rect.w - W * s) / 2, top: (rect.h - H * s) / 2, width: W, height: H, transformOrigin: "0 0", transform: `scale(${s})` }}>
+        {children}
+      </div>
+    </div>
+  );
+};
+
+export type RippleState = { x: number; y: number; t: number; alpha: number } | null;
+
+/** The pressed ripple: a circle from the touch point growing to cover the bounded shape, then fading. */
+export const Ripple: React.FC<{ rect: PxRect & { radius: number }; state: RippleState; color: string; dy?: number }> = ({ rect, state, color, dy = 0 }) => {
+  if (!state || state.alpha <= 0.002) return null;
+  const far = Math.max(
+    Math.hypot(state.x - rect.x, state.y - rect.y),
+    Math.hypot(state.x - rect.x - rect.w, state.y - rect.y),
+    Math.hypot(state.x - rect.x, state.y - rect.y - rect.h),
+    Math.hypot(state.x - rect.x - rect.w, state.y - rect.y - rect.h),
+  );
+  const r = far * (0.3 + 0.7 * state.t);
+  return (
+    <div style={{ position: "absolute", left: rect.x, top: rect.y + dy, width: rect.w, height: rect.h, borderRadius: rect.radius, overflow: "hidden" }}>
+      <div
+        style={{
+          position: "absolute",
+          left: state.x - rect.x - r,
+          top: state.y - rect.y - r,
+          width: 2 * r,
+          height: 2 * r,
+          borderRadius: "50%",
+          background: color,
+          opacity: state.alpha,
+        }}
+      />
+    </div>
+  );
+};
+
+/** A fingertip on the glass (screen px). */
+export const TouchDisc: React.FC<{ x: number; y: number; opacity: number; squash?: number }> = ({ x, y, opacity, squash = 1 }) => {
+  if (opacity <= 0.002) return null;
+  const d = PHONE.touch.d * SCREEN.w;
+  return (
+    <div
+      style={{
+        position: "absolute",
+        left: x - d / 2,
+        top: y - d / 2,
+        width: d,
+        height: d,
+        borderRadius: "50%",
+        background: `rgba(23, 24, 26, ${PHONE.touch.fillAlpha})`,
+        // the Ink ring, and a thin Mannequin edge outside it so the fingertip also reads on the app's Ink buttons
+        boxShadow: `inset 0 0 0 ${d * 0.05}px rgba(23, 24, 26, ${PHONE.touch.ringAlpha}), 0 0 0 ${d * 0.025}px rgba(251, 251, 249, 0.75)`,
+        opacity,
+        transform: `scale(${squash})`,
+      }}
+    />
+  );
+};
+
+const clip = (r: PxRect, radius = 0): React.CSSProperties => ({ position: "absolute", left: r.x, top: r.y, width: r.w, height: r.h, overflow: "hidden", borderRadius: radius });
+
+export const LibraryScreen: React.FC<{ scroll: number; ripple?: RippleState }> = ({ scroll, ripple = null }) => {
+  const bar = LIBRARY.barBottom;
+  return (
+    <div style={{ position: "absolute", inset: 0, background: theme.color.paper }}>
+      {/* the grid, scrolled under the bar */}
+      <div style={clip({ x: 0, y: bar, w: SCREEN.w, h: SCREEN.h - bar })}>
+        <Img src={staticFile(SRC.libraryTall)} style={{ position: "absolute", left: 0, top: -bar - scroll, width: SCREEN.w, height: LIBRARY.tallHeight }} />
+        <div style={{ position: "absolute", left: 0, top: -bar, width: SCREEN.w, height: LIBRARY.tallHeight }}>
+          <Ripple rect={LIBRARY.pickTile} state={ripple} color={theme.color.ink} dy={-scroll} />
+        </div>
+      </div>
+      {/* the top bar */}
+      <div style={clip({ x: 0, y: 0, w: SCREEN.w, h: bar })}>
+        <Img src={staticFile(SRC.libraryTall)} style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: LIBRARY.tallHeight }} />
+      </div>
+      {/* the camera button, fixed bottom-end */}
+      <div style={clip(LIBRARY.fab, LIBRARY.fab.radius)}>
+        <Img src={staticFile(SRC.library)} style={{ position: "absolute", left: -LIBRARY.fab.x, top: -LIBRARY.fab.y, width: SCREEN.w, height: SCREEN.h }} />
+      </div>
+    </div>
+  );
+};
+
+export const DetailScreen: React.FC<{ ripple?: RippleState; rippleRect?: PxRect & { radius: number } }> = ({ ripple = null, rippleRect }) => (
+  <div style={{ position: "absolute", inset: 0, background: theme.color.paper }}>
+    <Img src={staticFile(SRC.detail)} style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: SCREEN.h }} />
+    {rippleRect && <Ripple rect={rippleRect} state={ripple} color={theme.color.mannequin} />}
+  </div>
+);
+
+/** The camera screen: black, the live preview in the preview box, the app's chrome over it (alpha from matte.py). */
+export const CameraScreen: React.FC<{
+  frame: number;
+  live?: LivePreviewOptions;
+  /** 0..1: the last photo arriving in the gallery thumbnail (after the capture) */
+  thumb?: number;
+  /** 0..1: the "Saved to Pictures/Poseit" snackbar arriving */
+  snackbar?: number;
+  /** the shutter's inner disc while the app captures (ShutterButton: 0.88 while `capturing`, 150 ms FastOutSlowIn) */
+  shutterScale?: number;
+}> = ({ frame, live = {}, thumb = 0, snackbar = 0, shutterScale = 1 }) => {
+  const p = CAMERA.preview;
+  const g = CAMERA.gallery;
+  const ring = 4.5; // 1.5 dp at xxhdpi
+  const sb = CAMERA.snackbarCard;
+  return (
+    <div style={{ position: "absolute", inset: 0, background: theme.color.liveView }}>
+      <PlateBox rect={p}>
+        <LivePreview frame={frame} {...live} />
+      </PlateBox>
+      <Img src={staticFile(SRC.camera)} style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: SCREEN.h }} />
+      {shutterScale < 0.999 && (
+        // the render's disc covered (it sits on black: the 45% scrim over the screen below the preview), redrawn scaled
+        <>
+          <div style={{ ...clip(CAMERA.shutter, CAMERA.shutter.w), background: theme.color.liveView }} />
+          <div style={{ ...clip(CAMERA.shutter, CAMERA.shutter.w), background: theme.color.mannequin, transform: `scale(${shutterScale})` }} />
+        </>
+      )}
+      {thumb > 0.002 && (
+        <div style={{ position: "absolute", left: g.x, top: g.y, width: g.w, height: g.h, opacity: thumb }}>
+          <PlateBox rect={{ x: ring, y: ring, w: g.w - 2 * ring, h: g.h - 2 * ring }} radius={g.w}>
+            <CapturedPhoto />
+          </PlateBox>
+          <div style={{ position: "absolute", inset: 0, borderRadius: "50%", boxShadow: `inset 0 0 0 ${ring}px ${theme.color.mannequin}` }} />
+        </div>
+      )}
+      {snackbar > 0.002 && (
+        <div style={{ ...clip(sb, 36), opacity: snackbar, transform: `scale(${0.9 + 0.1 * snackbar})`, transformOrigin: "50% 100%" }}>
+          <Img src={staticFile(SRC.cameraSaved)} style={{ position: "absolute", left: -sb.x, top: -sb.y, width: SCREEN.w, height: SCREEN.h }} />
+        </div>
+      )}
+    </div>
+  );
+};
+
+/** PhotoViewer's page without its photo (the film draws the captured frame in VIEWER.photo). */
+export const ViewerChrome: React.FC<{ opacity?: number }> = ({ opacity = 1 }) => (
+  <Img src={staticFile(SRC.viewer)} style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: SCREEN.h, opacity }} />
+);
