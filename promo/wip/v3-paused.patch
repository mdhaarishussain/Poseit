@@ -0,0 +1,98 @@
+/**
+ * Device.tsx: the generic phone of the v3 film (beats.ts PHONE). An Ink body with a thin bezel and round corners, a
+ * punch-hole camera, a 1.5 px Graphite edge light. No brand, no buttons, no tilt, no shadow.
+ *
+ *   <Device rect={screenRectAt(frame)}>{screen content laid out in the 1200 x 2580 box}</Device>
+ *
+ *   rect        the SCREEN rectangle (framing.ts ScreenRect: cx, w in W; top in H); the body grows around it
+ *   children    the screen's content in screen px (SCREEN.w x SCREEN.h, the app's render size), clipped to the
+ *               screen's rounded rectangle; use <ScreenImage> for an app render and position anything else in px
+ *   background  the screen's colour under the content (default black: an empty preview)
+ *   punchHole   draw the front camera (default true)
+ *
+ *   <ScreenImage src="screens/promo-library.png" />   an app render filling the 1200 x 2580 box (or `y`, `h` for a
+ *               taller render, e.g. a scrolled library)
+ *   <ScreenLayer>  a full-size absolutely positioned box in screen px, for stacking screens (transitions)
+ */
+import React from "react";
+import { AbsoluteFill, Img, staticFile } from "remotion";
+import { PHONE, type ScreenRect } from "../beats";
+import { theme } from "../theme";
+import { SCREEN, deviceBox, screenBox } from "./framing";
+
+export const Device: React.FC<{
+  rect: ScreenRect;
+  children?: React.ReactNode;
+  background?: string;
+  punchHole?: boolean;
+  style?: React.CSSProperties;
+}> = ({ rect, children, background = "#000000", punchHole = true, style }) => {
+  const b = screenBox(rect);
+  const d = deviceBox(rect);
+  const hole = PHONE.punchHole.d * SCREEN.w;
+  return (
+    <AbsoluteFill style={{ pointerEvents: "none", ...style }}>
+      {/* the body */}
+      <div
+        style={{
+          position: "absolute",
+          left: d.x,
+          top: d.y,
+          width: d.w,
+          height: d.h,
+          borderRadius: d.radius,
+          background: PHONE.body,
+          boxShadow: `inset 0 0 0 ${PHONE.rim.px}px rgba(90, 92, 91, ${PHONE.rim.alpha})`,
+        }}
+      />
+      {/* the screen: content in the app's 1200 x 2580 px box, scaled into the rect */}
+      <div
+        style={{
+          position: "absolute",
+          left: b.x,
+          top: b.y,
+          width: b.w,
+          height: b.h,
+          borderRadius: d.screenRadius,
+          overflow: "hidden",
+          background,
+          // keep the rounded clip on the GPU layer with transformed children
+          isolation: "isolate",
+        }}
+      >
+        <div style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: SCREEN.h, transformOrigin: "0 0", transform: `scale(${b.s})` }}>
+          {children}
+          {punchHole && (
+            <div
+              style={{
+                position: "absolute",
+                left: SCREEN.w / 2 - hole / 2,
+                top: PHONE.punchHole.cy * SCREEN.h - hole / 2,
+                width: hole,
+                height: hole,
+                borderRadius: "50%",
+                background: theme.color.liveView,
+                boxShadow: `0 0 0 ${hole * 0.08}px rgba(23, 24, 26, 0.6)`,
+              }}
+            />
+          )}
+        </div>
+      </div>
+    </AbsoluteFill>
+  );
+};
+
+/** A full-size box in screen px (1200 x 2580), for stacking and moving whole screens. */
+export const ScreenLayer: React.FC<{ children?: React.ReactNode; style?: React.CSSProperties }> = ({ children, style }) => (
+  <div style={{ position: "absolute", left: 0, top: 0, width: SCREEN.w, height: SCREEN.h, overflow: "hidden", ...style }}>{children}</div>
+);
+
+/** An app render (public/screens/*.png, 1200 px wide) placed in screen px: by default the whole screen. */
+export const ScreenImage: React.FC<{ src: string; y?: number; h?: number; x?: number; w?: number; style?: React.CSSProperties }> = ({
+  src,
+  x = 0,
+  y = 0,
+  w = SCREEN.w,
+  h = SCREEN.h,
+  style,
+}) => <Img src={staticFile(src)} style={{ position: "absolute", left: x, top: y, width: w, height: h, display: "block", ...style }} />;
