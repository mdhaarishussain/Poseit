+/**
+ * layout.ts: where things are on the app's own screens (px in the 1200 x 2580 renders of PromoScreens.kt), so the
+ * film's taps, scroll and overlays land on the real UI. Numbers are the test's measured bounds
+ * (app/build/promo-screens/promo-screens.json, Compose semantics bounds in the root) and, where the semantics give a
+ * text box rather than the shape, measured on the render's pixels (noted). Re-measure if PromoScreens changes.
+ *
+ *   LIBRARY   promo-library.png / promo-library-tall.png (LibraryScreen; the tall one is 1200 x 5160, identical to the
+ *             short one above y 2300)
+ *   DETAIL    promo-detail.png (PoseDetailScreen, "Hands in pockets")
+ *   CAMERA    promo-camera.png (the chrome, alpha solved by scripts/matte.py): preview, controls, gallery thumbnail
+ *   VIEWER    promo-viewer.png (PhotoViewer on one photo): the photo's box for a 9:16 picture
+ */
+export type PxRect = { x: number; y: number; w: number; h: number };
+
+export const SRC = {
+  library: "screens/promo-library.png",
+  libraryTall: "screens/promo-library-tall.png",
+  detail: "screens/promo-detail.png",
+  camera: "screens/promo-camera.png",
+  cameraSaved: "screens/promo-camera-saved.png",
+  viewer: "screens/promo-viewer.png",
+} as const;
+
+export const LIBRARY = {
+  tallHeight: 5160,
+  /** the large top bar ("Poseit" and three icons) stays put while the grid scrolls under it: its Paper runs y 124-203
+   * between the title and the search field (pixels), so the film cuts at 192 (64 dp) */
+  barBottom: 192,
+  /** the "Hands in pockets" card (semantics: the 3:4 image and its two label lines) */
+  pick: { x: 618, y: 1637, w: 522, h: 840 },
+  /** its 3:4 image tile (Set grey, Medium radius 12 dp), where the ripple draws */
+  pickTile: { x: 618, y: 1637, w: 522, h: 696, radius: 36 },
+  first: { x: 60, y: 1637, w: 522, h: 840 },
+  /** "99 poses" */
+  count: { x: 60, y: 1526, w: 1080, h: 54 },
+  /** the "Pose camera" button (Ink, Medium radius; pixels: the semantics give its label) */
+  fab: { x: 694, y: 2376, w: 446, h: 144, radius: 36 },
+} as const;
+
+export const DETAIL = {
+  /** "Hands in pockets", the Title line (left-aligned at the 20 dp gutter) */
+  title: { x: 60, y: 1478, w: 847, h: 96 },
+  /** "Try this pose" (PrimaryButton, Ink; pixels 401-1139 x 2346-2543 with its 48 dp touch target) */
+  tryButton: { x: 420, y: 2400, w: 720, h: 144, radius: 36 },
+  /** the figure's grey panel with its frame marks */
+  panel: { x: 60, y: 102, w: 1080, h: 1304 },
+} as const;
+
+export const CAMERA = {
+  /** the 9:16 preview box under the top bar (CameraContent: full width, top-aligned because it does not fit above the
+   * controls on a 400 x 860 dp screen, so the controls overlap its bottom on the 45% scrim) */
+  preview: { x: 0, y: 168, w: 1200, h: 2133 },
+  /** the controls panel (pose strip + shutter row) on Studio.ControlScrim */
+  controls: { x: 0, y: 2008, w: 1200, h: 572 },
+  /** GalleryThumb: a 52 dp disc; after a capture the last photo, cropped round, inside a 1.5 dp Mannequin ring */
+  gallery: { x: 96, y: 2346, w: 156, h: 156 },
+  shutter: { x: 504, y: 2328, w: 192, h: 192 },
+  /** the snackbar in promo-camera-saved.png ("Saved to Pictures/Poseit", "View"): its text line; the Sheet card is
+   * (pixels: Sheet 39-1160 x 1831-1968, with its hairline) sits on the controls */
+  snackbarText: { x: 84, y: 1867, w: 894, h: 66 },
+  snackbarCard: { x: 36, y: 1828, w: 1128, h: 144 },
+} as const;
+
+export const VIEWER = {
+  /** a 9:16 photo fitted in the viewer's 1200 x 2580 black page (ZoomableImage, ContentScale.Fit, centred) */
+  photo: { x: 0, y: (2580 - (1200 * 16) / 9) / 2, w: 1200, h: (1200 * 16) / 9 },
+} as const;
