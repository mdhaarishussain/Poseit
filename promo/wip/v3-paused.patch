+/**
+ * studio/lockup.ts: the v3 end lockup's geometry (B8, STORYBOARD v3 section 9), in one pure module so TheName and
+ * the caption layer (src/captions, the end lines C10-C12) place their parts from the same numbers. Fractions of the
+ * frame (W = 1080, H = 1920).
+ *
+ *   LOCKUP          the icon (disc 0.30 W, centred at 0.33 H), the wordmark (ink 0.56 W in TheName, its cap line
+ *                   centred at 0.475 H) and the three end lines (centred at 0.600 / 0.663 / 0.726 H, so they span
+ *                   about 0.57-0.75 H)
+ *   LOCKUP_ORIGIN   the point the living hold creeps about (px)
+ *   endCreep(f)     the living hold: 1.000 -> 1.010 over END_V3.resolved..end (drift), so the static end hold stays
+ *                   inside 0.6-1.4 s; the icon, the wordmark and the end lines all take it (one camera)
+ */
+import { theme } from "../../theme";
+import { drift } from "../../motion";
+import { END_V3 } from "../timing";
+
+const { W, H } = theme.size;
+
+export const LOCKUP = {
+  icon: { cx: 0.5, cy: 0.33, d: 0.3 },
+  wordmark: { capCentreY: 0.475, inkW: 0.5 },
+  endLines: { C10: 0.6, C11: 0.663, C12: 0.726 } as Record<string, number>,
+} as const;
+
+export const LOCKUP_ORIGIN: [number, number] = [W / 2, 0.5 * H];
+
+/** The living hold after the lines resolve: a slow camera creep about the lockup's centre. */
+export const endCreep = (f: number) => drift(f, [END_V3.wordmark, END_V3.end], [1, 1.012]);
