@@ -0,0 +1,50 @@
+/**
+ * Room.tsx: the real scene behind the phone (beats.ts ROOMS_V3, ROOM_LOOK): the plate the phone is filming, scaled
+ * 1.6x, blurred 28 px, printed in the Studio ramp and lifted 25% toward Sheet so the device and the captions read.
+ * It follows the phone's zoom at 0.4x (depth): room scale = ROOM_LOOK.scale x phoneScale ^ parallax.
+ *
+ *   <Room frame={global v3 frame} />            picks the plate from ROOMS_V3 (o1 to f240, then b5-live)
+ *   <Room frame plate="o1" />                   forces a plate (STORY's opening, a dev still)
+ *
+ * o1 holds source 3.5 s from f105 (the clip's man enters at 4.0 s). b5-live plays on v2's clock: plate frame of
+ * (v3 frame - LIVE_OFFSET), the same frames the phone's camera screen shows.
+ */
+import React from "react";
+import { AbsoluteFill } from "remotion";
+import { LIVE_OFFSET, ROOMS_V3, ROOM_LOOK } from "../beats";
+import { theme } from "../theme";
+import { Footage } from "../footage/Footage";
+import { phoneScaleAt } from "./framing";
+
+const { W } = theme.size;
+
+/** o1: the last source frame ever shown (3.5 s) is on screen from this frame on. */
+export const O1_HOLD_FROM = 105;
+
+/** The blur fades to transparent within about 3 sigma of the layer's edge: oversize the blurred layer by that. */
+const EDGE = 1 + (2 * 3 * ROOM_LOOK.blurPx) / W;
+
+export type RoomPlate = (typeof ROOMS_V3)[number]["plate"];
+
+export const roomPlateAt = (f: number): RoomPlate => (ROOMS_V3.find((r) => f >= r.from && f < r.to) ?? ROOMS_V3[ROOMS_V3.length - 1]).plate;
+
+export const Room: React.FC<{ frame: number; plate?: RoomPlate; scale?: number }> = ({ frame, plate, scale }) => {
+  const id = plate ?? roomPlateAt(frame);
+  const zoom = scale ?? ROOM_LOOK.scale * Math.pow(phoneScaleAt(frame), ROOM_LOOK.parallax);
+  const live = id === "b5-live";
+  const plateFrame = live ? frame - LIVE_OFFSET : frame;
+  return (
+    <AbsoluteFill style={{ background: theme.color.paper, overflow: "hidden" }}>
+      <AbsoluteFill style={{ transform: `scale(${EDGE})`, filter: `blur(${ROOM_LOOK.blurPx}px)` }}>
+        <Footage
+          id={id}
+          frame={plateFrame}
+          look="duotone"
+          freezeAt={live ? undefined : O1_HOLD_FROM}
+          transform={{ scale: zoom / EDGE, anchor: [0.5, 0.5], dx: 0, dy: 0 }}
+        />
+      </AbsoluteFill>
+      <AbsoluteFill style={{ background: theme.color.sheet, opacity: ROOM_LOOK.liftToSheet }} />
+    </AbsoluteFill>
+  );
+};
