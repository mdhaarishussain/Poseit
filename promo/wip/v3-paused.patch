+                    photos = listOf(photo),
+                    initialPhoto = photo,
+                    snackbarHostState = remember { SnackbarHostState() },
+                    onClose = {}, onCurrentPhotoChanged = {}, onShare = {}, onOpenExternally = {},
+                    onDeleteConfirmed = {}, onQuickDelete = {}, onReviewFinished = {},
+                )
+            }
+        }
+        val close = node(hasContentDescription("Close viewer"), unmerged = true).boundsInRoot
+        val keep = node(hasText("Keep", substring = true), unmerged = true).boundsInRoot
+        record("viewer", "close" to close, "keep" to keep)
+    }
+
+    // ------------------------------------------------------------------------------------------------- the icon
+
+    @Test
+    @Config(qualifiers = "w256dp-h256dp-xxxhdpi")
+    fun icon() = render("promo-icon") {
