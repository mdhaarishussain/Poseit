@@ -0,0 +1,117 @@
+/**
+ * captions/layout.ts: where and when every caption is (pure, no React; events.ts and voiceover.ts can read it).
+ * The source is beats.ts CAPTIONS (the script) and CAPTION_SYSTEM (size, card, bands, motion); nothing here is a
+ * new number except where a comment says why.
+ *
+ *   CAP                   the caption type and card in px at 1080 x 1920 (Archivo SemiBold 0.051 H, line 0.056 H,
+ *                         cap height 0.035 H; Sheet card, padding 0.045 W x 0.016 H, radius 0.028 W)
+ *   captionWords(c)       the word onsets: 3 f apart through the whole sentence, from `from` (C1 from f-2, so its
+ *                         first word is already rising on f0). The end lines resolve in place instead (blur 8 -> 0
+ *                         px, 6 f). Built: C12 starts at f764 (boarded 752) so the lockup's last change is near f776
+ *                         and look.py's end hold is under 1.4 s (a slow creep counts as held; one word resolving
+ *                         alone is under its threshold, so a slower word rhythm did not help)
+ *   cardTop(c)            the card's top edge in px: top band 0.127 H; bottom band so the card's bottom is 0.865 H;
+ *                         end lines from studio/lockup.ts (no card)
+ *   captionsAt(f)         the captions on screen on frame f (at most one band caption; the end lines stack)
+ *   captionMotion(c, f)   { shown, rise px, opacity }: the card and its words rise 0.012 H and resolve (softLand 8 f),
+ *                         leave accelerating up 0.008 H over the last 6 f before `to` (accelExit)
+ *   wordMotion(w, f)      one word's rise and opacity (the end lines resolve instead: blur 8 -> 0 px in 6 f)
+ *   checkCaptions()       the script's own rules (12 f a word, 36 f minimum, never two band captions at once), as a
+ *                         list of problems; scripts/check-shapes.ts does not run it, the stills do
+ */
+import { CAPTIONS, CAPTION_SYSTEM, type Caption } from "../beats";
+import { theme } from "../theme";
+import { tween } from "../motion";
+import { LOCKUP } from "../scenes/studio/lockup";
+
+const { W, H } = theme.size;
+const E = theme.ease;
+const M = CAPTION_SYSTEM.motion;
+
+export const CAP = {
+  family: CAPTION_SYSTEM.font.family,
+  wordmarkFamily: CAPTION_SYSTEM.font.wordmarkFamily,
+  weight: CAPTION_SYSTEM.font.weight,
+  size: CAPTION_SYSTEM.font.sizeH * H,
+  line: CAPTION_SYSTEM.font.lineH * H,
+  padX: CAPTION_SYSTEM.card.padXW * W,
+  padY: CAPTION_SYSTEM.card.padYH * H,
+  radius: CAPTION_SYSTEM.card.radiusW * W,
+  fill: CAPTION_SYSTEM.card.fill,
+  ink: CAPTION_SYSTEM.card.ink,
+  maxLine: CAPTION_SYSTEM.maxLineW * W,
+} as const;
+
+export type CaptionWord = { text: string; at: number; line: number };
+
+/** C1 starts 2 f before the film so the first word is half-risen on f0 (STORYBOARD v3 B1). */
+const startOf = (c: Caption) => (c.id === "C1" ? c.from - 2 : c.from);
+
+
+export const captionWords = (c: Caption): CaptionWord[] => {
+  const out: CaptionWord[] = [];
+  let at = startOf(c);
+  c.lines.forEach((line, li) =>
+    line.split(/\s+/).filter(Boolean).forEach((text) => {
+      out.push({ text, at, line: li });
+      at += M.wordGap;
+    }),
+  );
+  return out;
+};
+
+export const cardHeight = (c: Caption) => c.lines.length * CAP.line + 2 * CAP.padY;
+
+export const cardTop = (c: Caption): number => {
+  if (c.band === "top") return CAPTION_SYSTEM.bands.topCardTopH * H;
+  if (c.band === "bottom") return CAPTION_SYSTEM.bands.bottomCardBottomH * H - cardHeight(c);
+  // end lines: no card; the line box is centred on its lockup row
+  return (LOCKUP.endLines[c.id] ?? 0.7) * H - CAP.line / 2;
+};
+
+export const captionsAt = (f: number): Caption[] =>
+  CAPTIONS.filter((c) => f >= startOf(c) && f < c.to);
+
+export const captionMotion = (c: Caption, f: number) => {
+  const a = startOf(c);
+  const shown = f >= a && f < c.to;
+  if (c.band === "end") return { shown, rise: 0, opacity: 1 };
+  const inRise = tween(f, [a, a + M.inFrames], [M.riseH * H, 0], E.softLand);
+  const inOp = tween(f, [a, a + 4], [0, 1], E.softInOut);
+  const out0 = c.to - M.outFrames;
+  const outRise = tween(f, [out0, c.to], [0, -0.008 * H], E.accelExit);
+  const outOp = tween(f, [out0, c.to], [1, 0], E.accelExit);
+  return { shown, rise: inRise + outRise, opacity: inOp * outOp };
+};
+
+export const wordMotion = (c: Caption, w: CaptionWord, f: number) => {
+  if (f < w.at) return { opacity: 0, rise: 0, blur: 0 };
+  if (c.band === "end") {
+    return {
+      opacity: tween(f, [w.at, w.at + 6], [0.12, 1], E.softInOut),
+      rise: 0,
+      blur: tween(f, [w.at, w.at + 6], [8, 0], E.glide),
+    };
+  }
+  return {
+    opacity: tween(f, [w.at, w.at + 4], [0.2, 1], E.softInOut),
+    rise: tween(f, [w.at, w.at + M.inFrames], [M.riseH * H, 0], E.softLand),
+    blur: 0,
+  };
+};
+
+/** The script's rules, checked on the data (reading time, minimum, no two band captions at once, the band gap). */
+export const checkCaptions = (): string[] => {
+  const problems: string[] = [];
+  const band = CAPTIONS.filter((c) => c.band !== "end").sort((a, b) => a.from - b.from);
+  for (const c of CAPTIONS) {
+    const n = c.text.split(/\s+/).filter(Boolean).length;
+    const need = Math.max(CAPTION_SYSTEM.minFrames, n * CAPTION_SYSTEM.minFramesPerWord);
+    if (c.to - c.from < need) problems.push(`${c.id}: ${c.to - c.from} f on screen, needs ${need}`);
+    if (c.lines.join(" ") !== c.text) problems.push(`${c.id}: lines do not spell the text`);
+  }
+  for (let i = 1; i < band.length; i++) {
+    if (band[i].from - band[i - 1].to < CAPTION_SYSTEM.motion.minGap) problems.push(`${band[i - 1].id} and ${band[i].id} overlap`);
+  }
+  return problems;
+};
