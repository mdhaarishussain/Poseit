+#!/usr/bin/env python3
+"""matte.py: the camera chrome's alpha from two renders of the same screen, one over black and one over white.
+
+    python3 scripts/matte.py <over-black.png> <over-white.png> <out.png>
+
+For every pixel, a layer of colour C and alpha a over a background B gives a*C + (1 - a)*B, so over black (B = 0)
+and over white (B = 1): black = a*C, white = a*C + 1 - a, hence a = 1 - (white - black) and C = black / a. The
+result is the chrome exactly as the app composes it (the 45% control scrim stays 45%), over a transparent preview.
+Used by scripts/assets.sh for PromoScreens.kt's camera renders.
+"""
+import sys
+
+import numpy as np
+from PIL import Image
+
+
+def main(black_path: str, white_path: str, out_path: str) -> None:
+    b = np.asarray(Image.open(black_path).convert("RGB"), dtype=np.float64) / 255.0
+    w = np.asarray(Image.open(white_path).convert("RGB"), dtype=np.float64) / 255.0
+    if b.shape != w.shape:
+        raise SystemExit(f"matte: sizes differ {b.shape} {w.shape}")
+    a = np.clip(1.0 - (w - b).mean(axis=2), 0.0, 1.0)
+    c = np.where(a[..., None] > 1e-4, b / np.maximum(a[..., None], 1e-4), 0.0)
+    rgba = np.dstack([np.clip(c, 0, 1), a])
+    Image.fromarray(np.round(rgba * 255).astype(np.uint8), "RGBA").save(out_path, optimize=True)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 4:
+        raise SystemExit(__doc__)
+    main(*sys.argv[1:])
