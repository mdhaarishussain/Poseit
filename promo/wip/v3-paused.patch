+/**
+ * Opening.tsx: B1-B2 of the v3 film (f0-160, STORYBOARD v3 section 9), the problem and the name.
+ *
+ *   <Opening frame={global v3 frame} />
+ *   B1  f0-96    the phone stands in her white studio (o1, mk-34412): the room behind it is the same plate scaled,
+ *                blurred and lifted (phone/Room), the phone is at PHONE_FRAMING.W1 (phone/framing screenRectAt), and its
+ *                screen is a plain camera (phone/screens/PlainCamera) on her: she stands stiffly, hands clasped,
+ *                glancing about, real time. Nobody presses the shutter. Caption C1 (the caption layer, Promo.tsx).
+ *   B2  f96-160  on the beat the screen cuts to the Android launch screen of Poseit (phone/screens/LaunchScreen): the
+ *                launcher icon lands from 2.6x (softLand 8 f, a 4 f opacity helper, 6 px blur resolving in 6 f) while
+ *                the camera steps W1 -> W2 (framing.ts) and drifts. Caption C2. f160 hands exactly this frame (the
+ *                settled icon at W2.to, in o1's room) to PhoneDemo's library.
+ * The phone, its screens and the room are BUILDER APP's components, used read-only. The caption is not drawn here.
+ */
+import React from "react";
+import { AbsoluteFill } from "remotion";
+import { theme } from "../theme";
+import { tween } from "../motion";
+import { Device } from "../phone/Device";
+import { Room } from "../phone/Room";
+import { screenRectAt } from "../phone/framing";
+import { PlainCamera } from "../phone/screens/PlainCamera";
+import { LaunchScreen } from "../phone/screens/LaunchScreen";
+import { FilmGrain } from "../world/Grain";
+import { OPENING_V3 } from "./timing";
+
+const E = theme.ease;
+const T = OPENING_V3;
+
+/** The launcher icon's landing on the screen cut: from 2.6x, most of the travel in the first 4 frames. */
+export const launchIconAt = (f: number) => ({
+  scale: tween(f, T.iconLand, [2.6, 1], E.softLand),
+  opacity: tween(f, [T.iconLand[0], T.iconLand[0] + 4], [0.25, 1], E.softInOut),
+  blur: tween(f, [T.iconLand[0], T.iconLand[0] + 6], [6, 0], E.softLand),
+});
+
+export const Opening: React.FC<{ frame: number }> = ({ frame }) => {
+  const rect = screenRectAt(frame);
+  const launch = frame >= T.screenCut;
+  const icon = launchIconAt(frame);
+  return (
+    <AbsoluteFill style={{ background: theme.color.paper }}>
+      <Room frame={frame} plate="o1" />
+      <Device rect={rect} background={launch ? theme.color.paper : theme.color.liveView}>
+        {launch ? (
+          <LaunchScreen iconScale={icon.scale} iconOpacity={icon.opacity} blur={icon.blur} />
+        ) : (
+          <PlainCamera frame={frame} plate="o1" />
+        )}
+      </Device>
+      <FilmGrain />
+    </AbsoluteFill>
+  );
+};
