@@ -0,0 +1,122 @@
+/**
+ * framing.ts: where the phone's SCREEN is on every frame (STORYBOARD.md v3 section 11). Pure, no React.
+ *
+ * A ScreenRect is { cx, top, w }: cx and w in W (1080), top in H (1920); the screen's height follows from the app's
+ * render aspect (beats.ts screenHeightH). Moves between the named framings in beats.ts PHONE_FRAMING are one camera
+ * group: device, screen and everything on it scale together (captions and the room do not).
+ *
+ *   screenRectAt(f)          the screen rectangle on global v3 frame f (W1 ... PHOTO, then held)
+ *   screenBox(rect)          the same in film px: { x, y, w, h, s } (s = film px per screen px of the 1200 x 2580 box)
+ *   screenToFilm(rect, p)    a point in screen px (1200 x 2580 box) -> film px
+ *   filmToScreen(rect, p)    the inverse
+ *   scaleRectAbout(r, s, p)  the rect scaled by s about a film point p (px): a camera step or push about a point
+ *   lerpRect(a, b, t)        component-wise mix
+ *   phoneScaleAt(f)          screen width / W1's starting width (the room's parallax reads it)
+ *
+ * The track (frame, framing, ease of the segment ending there):
+ *   f0-96 W1 drift; f96-106 W2 softLand, drift to f160 (STORY's seam into the library, exactly W2.to on f160);
+ *   f160-176 M softLand, drift to f226; f228-240 D1 (gentle in-out), drift to f246; f246-258 D2 softLand, drift to
+ *   f264; f264-284 W3 softLand, drift to f312; f312-330 C softLand, drift to f382; f382-402 W3 softLand, drift to
+ *   f490; f490-516 PHOTO softLand. The lock's 1.5% step (f361) and the photo's slow push are applied by PhoneDemo
+ *   with scaleRectAbout, about points it knows (the guide, her mid-hip).
+ */
+import { PHONE, PHONE_FRAMING, screenHeightH, type ScreenRect } from "../beats";
+import { theme } from "../theme";
+
+const { W, H } = theme.size;
+const E = theme.ease;
+
+/** The app's screen renders: the box every screen's content is laid out in (px). */
+export const SCREEN = { w: 1200, h: 2580 } as const;
+
+type Ease = (t: number) => number;
+type Key = [frame: number, rect: ScreenRect, ease?: Ease];
+
+const F = PHONE_FRAMING;
+
+const TRACK: Key[] = [
+  [F.W1.frames[0], F.W1.from],
+  [F.W1.frames[1], F.W1.to, E.drift],
+  [106, F.W2.from, E.softLand],
+  [F.W2.frames[1], F.W2.to, E.drift],
+  [176, F.M.from, E.softLand],
+  [F.M.frames[1], F.M.to, E.drift],
+  [F.D1.frames[0], F.M.to, E.drift],
+  [240, F.D1.from, E.softInOut],
+  [F.D1.frames[1], F.D1.to, E.drift],
+  [258, F.D2.from, E.softLand],
+  [F.D2.frames[1], F.D2.to, E.drift],
+  [284, F.W3.from, E.softLand],
+  [F.W3.frames[1], F.W3.to, E.drift],
+  [330, F.C.from, E.softLand],
+  [F.C.frames[1], F.C.to, E.drift],
+  [402, F.W3.to, E.softLand],
+  [F.PHOTO.frames[0], { ...F.W3.to, w: F.W3.to.w * 1.012 }, E.drift],
+  [F.PHOTO.frames[1], F.PHOTO.to, E.softLand],
+];
+
+export const lerpRect = (a: ScreenRect, b: ScreenRect, t: number): ScreenRect => ({
+  cx: a.cx + (b.cx - a.cx) * t,
+  top: a.top + (b.top - a.top) * t,
+  w: a.w + (b.w - a.w) * t,
+});
+
+/**
+ * Mixes two framings as a camera move: the width in log space (a push reads as a constant zoom rate) and the screen's
+ * centre linearly, so a pull back and a push in look like one camera, not a rectangle being resized.
+ */
+const moveRect = (a: ScreenRect, b: ScreenRect, t: number): ScreenRect => {
+  const w = a.w * Math.pow(b.w / a.w, t);
+  const ha = screenHeightH(a.w), hb = screenHeightH(b.w);
+  const cyA = a.top + ha / 2, cyB = b.top + hb / 2;
+  const cy = cyA + (cyB - cyA) * t;
+  return { cx: a.cx + (b.cx - a.cx) * t, top: cy - screenHeightH(w) / 2, w };
+};
+
+export const screenRectAt = (f: number): ScreenRect => {
+  if (f <= TRACK[0][0]) return TRACK[0][1];
+  for (let i = 1; i < TRACK.length; i++) {
+    const [f1, r1, e] = TRACK[i];
+    if (f <= f1) {
+      const [f0, r0] = TRACK[i - 1];
+      const u = f1 > f0 ? (f - f0) / (f1 - f0) : 1;
+      return moveRect(r0, r1, (e ?? E.softLand)(Math.min(1, Math.max(0, u))));
+    }
+  }
+  return TRACK[TRACK.length - 1][1];
+};
+
+export type Box = { x: number; y: number; w: number; h: number; s: number };
+
+export const screenBox = (r: ScreenRect): Box => {
+  const w = r.w * W;
+  const h = screenHeightH(r.w) * H;
+  return { x: r.cx * W - w / 2, y: r.top * H, w, h, s: w / SCREEN.w };
+};
+
+export const screenToFilm = (r: ScreenRect, [x, y]: [number, number]): [number, number] => {
+  const b = screenBox(r);
+  return [b.x + x * b.s, b.y + y * b.s];
+};
+
+export const filmToScreen = (r: ScreenRect, [x, y]: [number, number]): [number, number] => {
+  const b = screenBox(r);
+  return [(x - b.x) / b.s, (y - b.y) / b.s];
+};
+
+export const scaleRectAbout = (r: ScreenRect, s: number, [px, py]: [number, number]): ScreenRect => {
+  const cx = r.cx * W, top = r.top * H;
+  return { cx: (px + (cx - px) * s) / W, top: (py + (top - py) * s) / H, w: r.w * s };
+};
+
+export const phoneScaleAt = (f: number) => screenRectAt(f).w / F.W1.from.w;
+
+/** The device's outer rectangle (film px) around a screen rect: the bezel is PHONE.bezel of the screen width. */
+export const deviceBox = (r: ScreenRect) => {
+  const b = screenBox(r);
+  const bezel = PHONE.bezel * b.w;
+  const w = b.w + 2 * bezel;
+  const h = b.h + 2 * bezel;
+  const radius = PHONE.deviceRadius * w;
+  return { x: b.x - bezel, y: b.y - bezel, w, h, bezel, radius, screenRadius: Math.max(0, radius - bezel) };
+};
